<?xml version="1.0" encoding="utf-8"?>
<!--
  v107.0 — goal progress bar.

  A plain ProgressBar drawable rather than a drawn bitmap, so the track and fill
  colours resolve in the LAUNCHER's process and follow the system theme. (The week
  bars underneath cannot do this — they need a Canvas — which is exactly why they
  use a single amber that works in both modes.)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_accent" />
                <corners android:radius="99dp" />
            </shape>
        </clip>
    </item>
</layer-list>
