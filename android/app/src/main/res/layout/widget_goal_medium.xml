<?xml version="1.0" encoding="utf-8"?>
<!--
  v108.2 — 2x2, in the BSF Solar visual language. Same four bands as 4x2 minus
  the aux glyph row, which is what the spec called for and what the height allows.

  A 2x2 cell is 110x110dp — the SAME height as 4x2, with a quarter of the width.
  So the difference between these two files is horizontal room, and the things
  that get cut are the ones that need width to be legible:

    · the aux glyph row (three figures across ~95dp is three ellipses)
    · the sub-labels shrink, and "of $140k · 3%" carries what two lines did

  What is KEPT, because a glance needs an anchor and a verdict:
    · the ring — smaller (40dp) but still the first thing the eye lands on
    · the status pill, which is the whole "am I behind" answer in three words
    · the week chart, tappable, from v108.0
    · the action bar with its as-of time

  BUDGET (the failure mode here is silent — LinearLayout squeezes the LAST
  children to nothing without error, which is how the v107.0 build of this file
  rendered its bars as hairlines and dropped the week/rate row entirely):

      padding 2x7 = 14   header 13   body 40   chart 15   action 13   margins 9
      ——————————————————————————————————————————————————————————————————— 104

  6dp of slack, and the body row is the one on a weight so it absorbs rounding.
  If you add a row, take the height from somewhere and re-run WidgetRenderTest —
  assertNothingSqueezed() will fail on a zero-height child rather than leaving it
  to somebody noticing in a PNG.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="7dp">

    <!-- ── 1. HEADER ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/w_appname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:text="🎯 Invoice" />

        <!-- Spacer: at this width the FY does not fit beside the pill, so the
             label is bound only when there is no pill to compete with. -->
        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textSize="8sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink_dim"
            android:text="" />

        <TextView
            android:id="@+id/w_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="@color/widget_pill_ink"
            android:text="" />
    </LinearLayout>

    <!-- ── 2. BODY — ring | metrics ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/w_ringwrap"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_ringpct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:text="" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Text size is set from Java per state (WidgetRenderer.setHeadline). -->
            <TextView
                android:id="@+id/w_big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:textColor="@color/widget_accent"
                android:text="—" />

            <TextView
                android:id="@+id/w_of"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_dim"
                android:text="" />

            <TextView
                android:id="@+id/w_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── 3. WEEK CHART — full width here, since there is no aux row ────── -->
    <FrameLayout
        android:id="@+id/w_chart"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="3dp">

        <ImageView
            android:id="@+id/w_bars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/w_hits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <FrameLayout android:id="@+id/w_hit0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── 4. ACTION BAR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/w_actionbar"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_actionbar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/w_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:textColor="@color/widget_ink_dim"
            android:text="Tap to open" />

        <TextView
            android:id="@+id/w_asof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="7.5sp"
            android:singleLine="true"
            android:textColor="@color/widget_ink_dim"
            android:text="" />
    </LinearLayout>

</LinearLayout>
