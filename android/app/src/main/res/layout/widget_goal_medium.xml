<?xml version="1.0" encoding="utf-8"?>
<!--
  v107.0 — 2x2. The headline, plus the two things that change day to day.

  The extra height over 2x1 buys the week line ("This week 32.3h / 45h"), the
  all-time effective rate, and the six-week bar shape. Those three answer "am I
  working enough, at the right rate, and is this week normal" — the whole reason
  to glance at a widget rather than open the app.

  Deliberately NOT here: the gap figure and its explanation. Both are sentences,
  and a sentence squeezed into 110dp is a sentence nobody reads. They arrive at
  4x2, where there is room.

  SIZING IS TIGHT AND DELIBERATE. A 2x2 cell is 110x110dp, and after padding
  there are ~90dp of vertical room for six stacked elements. The first build of
  this layout asked for ~120dp: LinearLayout silently squeezed the last children
  to nothing, so the week bars rendered as hairlines and the week/rate row did
  not render at all. Every size here is chosen to sum UNDER the budget — if you
  add a row, take the height from somewhere, and re-run WidgetRenderTest.

  v108.0 note: that "LOOK at the PNG" instruction is no longer the only defence.
  The render test now measures every VISIBLE child after layout and fails if one
  came out zero-height or if the headline was clipped, so the squeeze is a red
  test rather than a screenshot somebody has to notice. It was a false green.

  v108.0 grew the chart 12dp to 18dp to make the bars tappable at all. The 6dp
  was taken back from padding (10 to 8) and two margins (5 to 4, 3 to 2) so the
  budget is unchanged — NOT from the headline, which was already at its floor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_ink_dim"
        android:text="🎯 Retained" />

    <!-- Text size is set from Java per state (see WidgetRenderer.headlineSp). -->
    <TextView
        android:id="@+id/w_big"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="1dp"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="@color/widget_accent"
        android:text="—" />

    <TextView
        android:id="@+id/w_of"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="9.5sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_ink_dim"
        android:text="" />

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <!-- Absorbs slack so the block below sits on the bottom edge.
         FrameLayout, NOT Space: RemoteViews only inflates classes carrying the
         @RemoteView annotation, and android.widget.Space does not. It fails at
         apply() time in the launcher, so the widget just never draws and the
         reason lands in the launcher's logcat rather than ours. Plain View is
         not allowed either. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── v108.0 week chart, tappable ────────────────────────────────────────
         The bars are still ONE bitmap: RemoteViews cannot size a child below API
         31, so a real per-bar view would draw wrong on Steven's own phone class.
         But a bitmap cannot be hit-tested either, so the tap targets are six
         invisible weighted cells laid OVER it. Both the bitmap's bars and the
         cells divide the same width evenly, so cell i sits exactly on bar i —
         that correspondence is the whole trick, and it is asserted in the render
         test rather than trusted.

         The cells are FrameLayout, NOT Space or View: RemoteViews only inflates
         classes carrying @RemoteView, and it fails at apply() time in the
         LAUNCHER, so the widget just never draws and the reason lands in someone
         else's logcat. Same trap as the spacer above.

         18dp is short of the 48dp touch-target guidance and there is no honest
         way around it — a 2x2 cell is 110dp tall in total. A miss lands on the
         card, which opens Stats, so the fallback is useful rather than dead. -->
    <FrameLayout
        android:id="@+id/w_chart"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp">

        <ImageView
            android:id="@+id/w_bars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/w_hits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <FrameLayout android:id="@+id/w_hit0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
            <FrameLayout android:id="@+id/w_hit5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- The effective rate does NOT appear at this size. It is an all-time figure
         that moves very slowly, and fitting it here pushed "This week 32.3h / 45h"
         into an ellipsis — a truncated live number is worse than a missing slow
         one. It appears at 4x2, where the footer has a slot for it. -->
    <TextView
        android:id="@+id/w_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_ink"
        android:text="" />

</LinearLayout>
