<?xml version="1.0" encoding="utf-8"?>
<!--
  v107.0 — 4x2. Two columns over a full-width footer: the number on the left,
  what it is made of on the right, the six-week shape underneath.

  This is the only size with room for sentences, so it is the only size that gets
  the verdict and the caveat. The verdict is a signed distance from a straight
  line ("Behind by $8,797 …"), passed through from the app verbatim and never
  softened — a home screen is exactly where "on track" would be read as a fact
  rather than a reassurance, which is why that vocabulary is banned outright and
  asserted by a test.

  The caveat underneath is earned, not decorative: it says how many of the elapsed
  weeks actually had hours in them, which is the difference between an attendance
  gap and a rate problem. When the weeks are steady it does not render at all.

  THE HEIGHT BUDGET IS THE SAME 110dp AS 2x2 — four cells wide buys width, not
  height. The first build stacked label/big/of/bar/milestones/bars in the left
  column, which came to ~50% more than the column had: LinearLayout squeezed the
  bar, the milestones and the bars out of existence WITHOUT ERROR, and the big
  number ellipsised to "$3,9…". So the week bars moved to a full-width footer
  (where they also read better), the milestone chips ride beside them, and the
  headline autosizes. If you add a row here, take the height from somewhere and
  re-run WidgetRenderTest.

  v108.0 note: overflow is no longer silent. The render test measures every
  VISIBLE child after layout and fails on a zero-height one or a clipped
  headline, which is what "LOOK at the PNG" was standing in for.

  v108.0 grew the footer chart 14dp to 20dp so its bars can be tapped. The 6dp
  came from padding (12 to 10) and the footer margin (6 to 4) — deliberately NOT
  from the top row, because the headline lives there on a weight and would have
  silently lost 6dp of glyph height rather than shrinking its text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- LEFT — the goal itself. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="44"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_dim"
                android:text="🎯 Retained" />

            <!-- Text size is set from Java per state (see WidgetRenderer.headlineSp). -->
            <TextView
                android:id="@+id/w_big"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/widget_accent"
                android:text="—" />

            <TextView
                android:id="@+id/w_of"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_dim"
                android:text="" />

            <ProgressBar
                android:id="@+id/w_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <!-- RIGHT — what the number is made of. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="56"
            android:layout_marginStart="13dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:text="" />

            <TextView
                android:id="@+id/w_note"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:textSize="8.5sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_ink_dim"
                android:text="" />

            <TextView
                android:id="@+id/w_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- FOOTER — the six-week shape, the milestone ticks, and the two small
         figures that had nowhere else to sit. Full width, so the bars get enough
         pixels per bar to actually read as a trend. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- ── v108.0 week chart, tappable — see widget_goal_medium.xml for why
             the bars are one bitmap with six invisible cells laid over it.
             Wider here (weight 26 to 38) as well as taller: 4x2 is the size with
             the pixels to make six weeks read as a trend rather than a texture,
             and a wider cell is also a more forgiving tap. -->
        <FrameLayout
            android:id="@+id/w_chart"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="38">

            <ImageView
                android:id="@+id/w_bars"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/w_hits"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <FrameLayout android:id="@+id/w_hit0"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_hit1"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_hit2"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_hit3"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_hit4"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_hit5"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/w_milestones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="40"
            android:layout_marginStart="8dp"
            android:textSize="8.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink_dim"
            android:text="" />

        <!-- The six-week chart to the left already shows last week, and shows it
             in context, so this slot carries the rate rather than repeating it. -->
        <TextView
            android:id="@+id/w_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="22"
            android:layout_marginStart="6dp"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="end"
            android:textColor="@color/widget_ink_dim"
            android:text="" />
    </LinearLayout>

</LinearLayout>
